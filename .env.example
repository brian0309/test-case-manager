
# Server Configuration
PORT=5000
NODE_ENV=development
# Vercel serverless flag (set to 1 in Vercel environments)
#VERCEL=0

# MongoDB Connection
MONGO_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret_key

# Mailtrap (Email Service)
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/
# Optional: override the "from" address and display name used for sent emails
# If not set, the code falls back to the built-in defaults:
#   MAILTRAP_SENDER_EMAIL -> mailtrap@demomailtrap.com
#   MAILTRAP_SENDER_NAME  -> MERN Auth
MAILTRAP_SENDER_EMAIL=mailtrap@demomailtrap.com
MAILTRAP_SENDER_NAME=MERN Auth
# Optional: Mailtrap template UUID for welcome emails (fallbacks to local HTML if not set)
# MAILTRAP_WELCOME_TEMPLATE_UUID=your_mailtrap_template_uuid

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Comma-separated list of allowed redirect URIs (required)
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:5000/api/auth/google/callback

# CORS Configuration
# Comma-separated list of allowed origins for CORS (required)
# Examples:
# Development: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://preview-123.vercel.app
# If not set, will fall back to CLIENT_URL (deprecated, use ALLOWED_ORIGINS instead)
ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL (deprecated - use ALLOWED_ORIGINS instead)
# This is kept for backward compatibility
CLIENT_URL=http://localhost:5173

# Optional: cookie domain for auth cookies (e.g., .example.com)
#COOKIE_DOMAIN=

# Encryption key for Gemini API key storage (must be 32 characters)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Google Drive (video evidence)
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. The Drive OAuth callback
# (redirect URI) must be registered in the Google Cloud Console alongside the
# login callback, and listed in GOOGLE_ALLOWED_REDIRECT_URIS.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/drive/auth/callback
# Encryption key for Drive refresh tokens (must be 32 characters).
# Falls back to ENCRYPTION_KEY when not set.
GOOGLE_TOKEN_ENCRYPTION_KEY=your_32_char_drive_token_encryption_key
# Name of the top-level folder created in each user's Drive (default: Test Case Manager)
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Test Case Manager
# Maximum video size allowed for evidence uploads, in MB (default: 1024)
VIDEO_EVIDENCE_MAX_SIZE_MB=1024

# S3-Compatible Storage (Cloudflare R2, AWS S3, MinIO, etc.)
# Required for image uploads in Tiptap editor
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# For Cloudflare R2: https://ACCOUNT_ID.r2.cloudflarestorage.com
# For AWS S3: https://s3.REGION.amazonaws.com or leave empty for default
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=your-bucket-name
# For Cloudflare R2 use 'auto', for AWS S3 use your region (e.g., 'us-east-1')
S3_REGION=auto
# Optional: Public URL for accessing uploaded files (e.g., custom domain or CDN)
# If not set, will use S3_ENDPOINT/S3_BUCKET_NAME/key format
S3_PUBLIC_URL=https://your-custom-domain.com
