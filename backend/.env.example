# MongoDB Connection
MONGO_URI=your_mongodb_connection_string

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key

# Mailtrap (Email Service)
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/
MAILTRAP_SENDER_EMAIL=mailtrap@demomailtrap.com
MAILTRAP_SENDER_NAME=MERN Auth

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.vercel.app/api/auth/google/callback
# Comma-separated list of allowed redirect URIs (required)
GOOGLE_ALLOWED_REDIRECT_URIS=https://your-backend.vercel.app/api/auth/google/callback

# CORS Configuration
# Comma-separated list of allowed origins for CORS (required)
# Example: ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://preview-123.vercel.app,https://preview-456.vercel.app
# If not set, will fall back to CLIENT_URL (deprecated, use ALLOWED_ORIGINS instead)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Frontend URL (deprecated - use ALLOWED_ORIGINS instead)
# This is kept for backward compatibility
CLIENT_URL=https://your-frontend.vercel.app

# Node Environment
NODE_ENV=production

# Optional: set COOKIE_DOMAIN when you want to share cookies across subdomains (e.g. .example.com)
# COOKIE_DOMAIN=.example.com

# S3-Compatible Storage (Cloudflare R2, AWS S3, MinIO, etc.)
# Required for image uploads in Tiptap editor
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# For Cloudflare R2: https://ACCOUNT_ID.r2.cloudflarestorage.com
# For AWS S3: https://s3.REGION.amazonaws.com or leave empty for default
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=your-bucket-name
# For Cloudflare R2 use 'auto', for AWS S3 use your region (e.g., 'us-east-1')
S3_REGION=auto
# Optional: Public URL for accessing uploaded files (e.g., custom domain or CDN)
# If not set, will use S3_ENDPOINT/S3_BUCKET_NAME/key format
S3_PUBLIC_URL=https://your-custom-domain.com
