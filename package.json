{
	"name": "auth-tutorial",
	"version": "1.0.0",
	"description": "",
	"main": "backend/index.ts",
	"scripts": {
		"dev": "cross-env NODE_ENV=development tsx watch backend/index.ts",
		"start": "cross-env NODE_ENV=production node dist/backend/index.js",
		"build": "npm install && tsc -p backend/tsconfig.json && npm install --prefix frontend && npm run build --prefix frontend",
		"build:render": "npm install --include=dev && tsc -p backend/tsconfig.json && npm install --include=dev --prefix frontend && npm run build --prefix frontend",
		"build:backend": "tsc -p backend/tsconfig.json",
		"type-check": "tsc -p backend/tsconfig.json --noEmit",
		"type-check:watch": "tsc -p backend/tsconfig.json --noEmit --watch",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:unit": "jest __tests__/unit",
		"test:integration": "jest __tests__/integration",
		"lint:backend": "eslint backend --ext .ts --report-unused-disable-directives"
	},
	"keywords": [],
	"author": "",
	"type": "module",
	"license": "MIT",
