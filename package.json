		"bcryptjs": "^2.4.3",
		"cookie": "^1.1.1",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"crypto": "^1.0.1",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"express-rate-limit": "^8.2.1",
		"google-auth-library": "^10.5.0",
		"jsonwebtoken": "^9.0.2",
		"mailtrap": "^3.4.0",
		"mongoose": "^8.5.2",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"sanitize-html": "^2.17.0",
		"socket.io": "^4.8.3",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@jest/globals": "^30.2.0",
		"@types/bcryptjs": "^2.4.6",
